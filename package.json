{
  "name": "shellwatch",
  "version": "0.0.0",
  "description": "SSH session broker with browser UI and MCP interface",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"go run ./cmd/shellwatch 2>&1 | tee logs/dev.log\" \"cd client && npx vite dev\"",
    "dev:server": "go run ./cmd/shellwatch 2>&1 | tee logs/dev.log",
    "build": "pnpm build:client && pnpm build:server",
    "build:server": "go build -o shellwatch ./cmd/shellwatch",
    "build:client": "cd client && npx svelte-kit sync && npx vite build",
    "start": "./shellwatch",
    "typecheck": "tsc --noEmit",
    "check:svelte": "cd client && npx svelte-kit sync && npx svelte-check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "cd client && npx svelte-kit sync",
    "test": "vitest run",
    "test:go": "go test ./...",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:up": "docker compose -f e2e/docker-compose.e2e.yml -p shellwatch-e2e up -d --build --wait",
    "e2e:down": "docker compose -f e2e/docker-compose.e2e.yml -p shellwatch-e2e down -v --remove-orphans",
    "test:e2e": "node e2e/scripts/ensure-build.mjs && vitest run --config e2e/vitest.e2e.config.ts",
    "test:e2e:logs": "docker compose -f e2e/docker-compose.e2e.yml -p shellwatch-e2e logs --no-color --timestamps",
    "hydra:migrate": "docker compose --profile hydra run --rm hydra migrate sql -e --yes",
    "update:aaguids": "tsx scripts/update-aaguids.ts",
    "licenses:bundle": "node scripts/bundle-licenses.mjs && bash scripts/bundle-go-licenses.sh",
    "spdx:check": "node scripts/spdx-headers.mjs",
    "spdx:write": "node scripts/spdx-headers.mjs --write",
    "api:preview": "npx --yes @redocly/cli@latest build-docs docs/api/openapi.yaml -o docs/api/openapi.html && open docs/api/openapi.html",
    "api:lint": "npx --yes @redocly/cli@latest lint docs/api/openapi.yaml",
    "api:codegen-check": "bash scripts/check-api-codegen.sh",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "Martin Riedel",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/server": "^13.3.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.5",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,svelte}": "eslint",
    "*.{ts,svelte,js,json,css,md,yaml,yml}": "prettier --write"
  }
}
